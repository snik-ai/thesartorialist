{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Sartorialist",
  "version": "1.0.0",
  "identifier": "ch.thesartorialist.admin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.business",
    "shortDescription": "The Sartorialist – Atelier-Backend",
    "longDescription": "Das Backend des Massateliers The Sartorialist für den Mac: Termine, Leads, Kunden, Angebote, Aufträge und Rechnungen in einem nativen Fenster, mit Mitteilungen, Menüleiste, Kurzbefehlen und Schreibtisch-Widget.",
    "copyright": "© 2026 The Sartorialist · DLM Digital",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 190 },
        "applicationFolderPosition": { "x": 440, "y": 190 }
      }
    }
  }
}
