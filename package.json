{
  "name": "thesartorialist",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "schrank": "node scripts/schrank-freistellen.mjs",
    "test:formular": "node --experimental-strip-types --no-warnings --test test/formular.test.mjs",
    "postbuild": "node -e \"require('fs').cpSync('drizzle','.next/standalone/drizzle',{recursive:true})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "next": "^15.5.29",
    "pdfkit": "0.20.2",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swissqrbill": "4.4.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.180.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
